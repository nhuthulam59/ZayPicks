# Copy this file to .env.local for local development,
# and set the same variables in Vercel (Project Settings -> Environment Variables).
# Never commit .env.local to GitHub.

# Required: the ID of your Google Sheet.
# From the Sheet URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
SHEET_ID=1JrBzwAVpbBuImQuN8bhHyXBupjN324bpPgXtZ4cfXN4

# Optional: search more than one spreadsheet — comma-separated IDs.
# Every spreadsheet listed here is searched, all tabs, all columns.
# Example: SHEET_IDS=1JrBzwAVpbBuImQuN8bhHyXBupjN324bpPgXtZ4cfXN4,ANOTHER_SHEET_ID
# SHEET_IDS=

# Optional: names for the per-sheet filter buttons, in the same order as
# SHEET_IDS. Only needed without GOOGLE_API_KEY — with a key, the site reads
# each spreadsheet's real title. Without it, buttons fall back to
# "Sheet 1", "Sheet 2", ...
# Example: SHEET_NAMES=Salary Statement,Outside Leads
# SHEET_NAMES=

# Optional: comma-separated list of tab names to search.
# If left empty, only "Sheet1" is read (unless GOOGLE_API_KEY is set, see below).
# Example: SHEET_TABS=Sheet1,Products,Contacts
SHEET_TABS=Sheet1

# Optional: a Google API key (Google Cloud -> APIs & Services -> Credentials).
# If set, the site uses the official Google Sheets API, which automatically
# discovers ALL tabs in the spreadsheet — you do not need SHEET_TABS.
# The Sheet must still be shared as "Anyone with the link can view".
# If you do not set this, the site uses the public CSV export instead.
# GOOGLE_API_KEY=
